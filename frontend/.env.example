# Copy to .env for local development
# true = in-memory mock (no backend needed); false = real FastAPI
VITE_USE_MOCK=true
# Base URL of the FastAPI backend (used when VITE_USE_MOCK=false).
# Empty = same-origin (deployed on Vercel, API served from /api). For local dev
# point it at the running uvicorn instance (npm run api serves backend:8000).
VITE_API_URL=http://localhost:8000
